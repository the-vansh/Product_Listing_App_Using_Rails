<div class="auth-page">
  <div class="auth-card">

<div class="auth-header">
  <h1>Welcome Back</h1>
  <p>Login to continue to Product Listing</p>
</div>

<%= form_with url: "/login", method: :post, data: { turbo: false }, class: "auth-form" do |form| %>

  <div class="form-group">
    <%= form.label :email, "Email Address" %>
    <%= form.email_field :email, placeholder: "Enter your email", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :password, "Password" %>
    <%= form.password_field :password, placeholder: "Enter your password", required: true %>
  </div>

  <%= form.submit "Login", class: "auth-button" %>

<% end %>

<div class="auth-footer">
  <p>Don't have an account?</p>
  <%= link_to "Create an account", "/signup" %>
</div>


  </div>
</div>
