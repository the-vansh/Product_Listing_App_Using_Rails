<section class="hero">

  <div class="hero-content">

    <span class="hero-badge">✦ Simple. Secure. Marketplace.</span>

    <h1>
      Discover products.
      <br>
      <span>Sell what you love.</span>
    </h1>

    <p class="hero-description">
      A simple place to discover products, list your own items,
      and connect with buyers — all in one place.
    </p>

    <div class="hero-actions">
      <%= link_to "Have An Account", "/login", class: "primary-btn" %>
      <%= link_to "Create an Account", "/signup", class: "secondary-btn" %>
    </div>

    <div class="hero-trust">
      <span>✓ Easy product listing</span>
      <span>✓ Multiple product images</span>
      <span>✓ Secure authentication</span>
    </div>

  </div>


  <div class="hero-visual">

    <div class="floating-card card-one">
      <span class="mini-icon">🛍️</span>
      <div>
        <strong>Discover</strong>
        <small>Find something you like</small>
      </div>
    </div>

    <div class="marketplace-card">

      <div class="marketplace-top">
        <span>Featured Marketplace</span>
        <span class="dot"></span>
      </div>

      <div class="fake-product-image">
        <span>PRODUCT</span>
      </div>

      <div class="fake-product-info">
        <div>
          <h3>Find your next favorite</h3>
          <p>Explore products from our community</p>
        </div>

        <strong>→</strong>
      </div>

    </div>

    <div class="floating-card card-two">
      <span class="mini-icon">✨</span>
      <div>
        <strong>Sell</strong>
        <small>List your products easily</small>
      </div>
    </div>

  </div>

</section>


<section class="features-section">

  <div class="section-heading">
    <span>WHY USE IT?</span>
    <h2>Everything you need to get started.</h2>
    <p>
      Built to keep buying and selling simple.
    </p>
  </div>


  <div class="features-grid">

    <div class="feature-card">
      <div class="feature-icon">🔐</div>
      <h3>Secure</h3>
      <p>
        Your account is protected with JWT-based authentication.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">📦</div>
      <h3>Easy Listing</h3>
      <p>
        Add products with descriptions, prices, quantities,
        and multiple images.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">🖼️</div>
      <h3>Multiple Images</h3>
      <p>
        Showcase your products from different angles with
        multiple product images.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">⚡</div>
      <h3>Simple Experience</h3>
      <p>
        Browse products and manage your listings without
        unnecessary complexity.
      </p>
    </div>

  </div>

</section>


<section class="cta-section">

  <div>
    <span>READY TO GET STARTED?</span>

    <h2>
      Your next product
      <br>
      could be right here.
    </h2>

    <p>
      Create your account and start exploring the marketplace.
    </p>
  </div>

  <%= link_to "Get Started →", "/signup", class: "cta-btn" %>

</section>